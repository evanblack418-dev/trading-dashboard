{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 .claude/skills/odds-check/odds.py:*)",
      "Read(trader/**)",
      "Edit(trader/**)",
      "Write(trader/**)"
    ],
    "deny": [
      "Edit(index.html)",
      "Write(index.html)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*(place|submit|replace|modify|cancel|close).*(order|position).*",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/order-guard.sh\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*(place|submit|replace|modify|cancel|close).*(order|position).*",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/order-guard.sh\"" }
        ]
      }
    ]
  }
}
